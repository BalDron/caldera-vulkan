#version 450

layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;

struct GpuCluster {
    vec4 sphere_bounds;   
    vec4 cone_axis_angle; 
    uint first_index;
    uint index_count;
    int  vertex_offset;
    uint instance_id;
};

struct DrawIndexedIndirectCommand {
    uint indexCount;
    uint instanceCount;
    uint firstIndex;
    int  vertexOffset;
    uint firstInstance;
};

layout(std430, set = 0, binding = 0) readonly buffer AllClusters {
    GpuCluster clusters[];
};

layout(std430, set = 0, binding = 1) readonly buffer CandidateClusters {
    uint candidate_cluster_indices[];
};

layout(std430, set = 0, binding = 2) readonly buffer CandidateCounter {
    uint total_candidate_clusters;
};

layout(std430, set = 0, binding = 3) writeonly buffer OutputCommands {
    DrawIndexedIndirectCommand output_commands[];
};

layout(std430, set = 0, binding = 4) buffer FinalDrawCount {
    uint visible_cluster_count;
};

layout(set = 0, binding = 5) uniform sampler2D hiz_texture;

layout(push_constant) uniform CullConstants {
    mat4 view_proj;
    vec4 camera_position;
    vec2 screen_dimensions;
} push_constants;

bool IsSphereInFrustum(vec3 center, float radius, mat4 vp) {
    vec4 planes[6];
    planes[0] = vec4(vp[0][3] + vp[0][0], vp[1][3] + vp[1][0], vp[2][3] + vp[2][0], vp[3][3] + vp[3][0]);
    planes[1] = vec4(vp[0][3] - vp[0][0], vp[1][3] - vp[1][0], vp[2][3] - vp[2][0], vp[3][3] - vp[3][0]);
    planes[2] = vec4(vp[0][3] + vp[0][1], vp[1][3] + vp[1][1], vp[2][3] + vp[2][1], vp[3][3] + vp[3][1]);
    planes[3] = vec4(vp[0][3] - vp[0][1], vp[1][3] - vp[1][1], vp[2][3] - vp[2][1], vp[3][3] - vp[3][1]);
    planes[4] = vec4(vp[0][2],            vp[1][2],            vp[2][2],            vp[3][2]);
    planes[5] = vec4(vp[0][3] - vp[0][2], vp[1][3] - vp[1][2], vp[2][3] - vp[2][2], vp[3][3] - vp[3][2]);

    for (int i = 0; i < 6; ++i) {
        float dist = dot(planes[i].xyz, center) + planes[i].w;
        float len = length(planes[i].xyz);
        if (dist < -radius * len) {
            return false;
        }
    }
    return true;
}

bool IsSphereOccluded(vec3 center, float radius, mat4 vp, vec2 screen_size) {
    vec4 clip_center = vp * vec4(center, 1.0);
    
    
    if (clip_center.w - radius <= 0.1) return false;

    
    vec3 to_cam = normalize(push_constants.camera_position.xyz - center);
    vec4 nearest_clip = vp * vec4(center + to_cam * radius, 1.0);
    if (nearest_clip.w <= 0.0) return false;
    float nearest_ndc_z = nearest_clip.z / nearest_clip.w;

    vec3 ndc_center = clip_center.xyz / clip_center.w;
    vec2 screen_center = ndc_center.xy * 0.5 + 0.5;

    float p00 = abs(vp[0][0]);
    float p11 = abs(vp[1][1]);
    vec2 uv_radius = vec2((radius * p00) / clip_center.w, (radius * p11) / clip_center.w);

    vec2 min_uv = clamp(screen_center - uv_radius, 0.0, 1.0);
    vec2 max_uv = clamp(screen_center + uv_radius, 0.0, 1.0);

    vec2 pixel_size = (max_uv - min_uv) * screen_size;
    float max_dim = max(pixel_size.x, pixel_size.y);
    float mip = max(0.0, floor(log2(max(1.0, max_dim))));

    
    vec4 d;
    d.x = textureLod(hiz_texture, vec2(min_uv.x, min_uv.y), mip).r;
    d.y = textureLod(hiz_texture, vec2(max_uv.x, min_uv.y), mip).r;
    d.z = textureLod(hiz_texture, vec2(min_uv.x, max_uv.y), mip).r;
    d.w = textureLod(hiz_texture, vec2(max_uv.x, max_uv.y), mip).r;
    float max_depth_in_region = max(max(d.x, d.y), max(d.z, d.w));

    
    float depth_bias = 0.003;
    return (nearest_ndc_z - depth_bias) > max_depth_in_region;
}

void main() {
    uint g_idx = gl_GlobalInvocationID.x;
    if (g_idx >= total_candidate_clusters) return;

    uint cluster_idx = candidate_cluster_indices[g_idx];
    GpuCluster cluster = clusters[cluster_idx];

    vec3 center = cluster.sphere_bounds.xyz;
    float radius = cluster.sphere_bounds.w;

    
    if (!IsSphereInFrustum(center, radius, push_constants.view_proj)) return;

    
    if (IsSphereOccluded(center, radius, push_constants.view_proj, push_constants.screen_dimensions)) return;

    
    uint write_idx = atomicAdd(visible_cluster_count, 1);
    output_commands[write_idx] = DrawIndexedIndirectCommand(
        cluster.index_count,
        1,
        cluster.first_index,
        cluster.vertex_offset,
        cluster.instance_id
    );
}